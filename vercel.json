{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index?_p=$1" }],
  "functions": {
    "api/index.py": {
      "maxDuration": 120,
      "includeFiles": "{synesthetic/**,lenses/**}",
      "excludeFiles": "{tests/**,research_notes/**,reports/**,chat-mod/**,tools/**,.venv/**}"
    }
  }
}
